{
  "name": "la-casa-rural",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "La Casa Rural: party game presencial multijugador para 6-12 personas.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "pg": "8.23.0",
    "socket.io": "4.8.3",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/big-shoulders-stencil-display": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "4.8.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
